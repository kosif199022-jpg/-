{
  "name": "@altareeq/cloudflare-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "types": "wrangler types worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run types && npm run typecheck && npm audit --audit-level=high && npm run deploy:dry-run",
    "dev": "wrangler dev --port 8788",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.8.1",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260820.0",
    "typescript": "6.0.3",
    "wrangler": "4.125.0"
  }
}
